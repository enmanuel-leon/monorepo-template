# ==============================================================================
# 🌐 1. SERVER & NETWORK CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# 🗄️ 2. DATABASE & CACHE INFRASTRUCTURE
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_template_db?schema=public
REDIS_URL=redis://localhost:6379

# ==============================================================================
# 🔒 3. AUTHENTICATION & SECURITY (Better Auth)
# ==============================================================================
BETTER_AUTH_SECRET=super-secret-key-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ==============================================================================
# 📁 4. MULTI-PROVIDER FILE STORAGE (local | s3 | gcs)
# ==============================================================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=local-bucket
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ==============================================================================
# 📧 5. TRANSACTIONAL EMAIL & SMTP (Resend / SendGrid / Mailtrap)
# ==============================================================================
# ⚠️ IMPORTANT FOR RESEND SMTP:
# Resend requires SMTP_FROM to use 'onboarding@resend.dev' (e.g. "App Template <onboarding@resend.dev>")
# unless you have verified your own custom domain on https://resend.com/domains.
EMAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_123456789
SMTP_FROM="App Template <onboarding@resend.dev>"
